{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo (scripted, no camera)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["demo"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run video: People in group demo.mp4",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["run", "--video", "People in group demo.mp4", "--display-every", "10"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run video: vtest.avi (sample)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["run", "--video", "vtest.avi", "--display-every", "10"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Preview frames (annotated PNGs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/preview_frames.py",
      "args": ["People in group demo.mp4"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pytest (tests + sign-off)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
